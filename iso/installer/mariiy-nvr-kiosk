#!/bin/sh
# Graphical kiosk launcher for Mariiy NVR.
if [ ! -f /etc/mariiy_nvr_os/installed ]; then
  echo "Installer media. Run mariiy-installer"
  sleep 5
  exit 1
fi

WEB=/usr/share/mariiy_nvr_os/web
cd "$WEB" || exit 1
export DISPLAY="${DISPLAY:-:0}"
export HOME=/root
export XAUTHORITY="${XAUTHORITY:-/root/.Xauthority}"

# Ensure loopback is up
ip link set lo up 2>/dev/null || ifconfig lo 127.0.0.1 up 2>/dev/null || true
ip addr add 127.0.0.1/8 dev lo 2>/dev/null || true

# Ensure backend services are running
rc-service mariiy-go2rtc start 2>/dev/null || true
rc-service mariiy-agent start 2>/dev/null || true
rc-service mariiy-ui start 2>/dev/null || true

# Wait for Web UI (port 8765) and start directly if needed
i=0
while [ "$i" -lt 15 ]; do
  if wget -q -O /dev/null http://127.0.0.1:8765/ 2>/dev/null \
    || busybox wget -q -O /dev/null http://127.0.0.1:8765/ 2>/dev/null; then
    break
  fi
  python3 -m http.server 8765 --bind 0.0.0.0 >/tmp/mariiy-http.log 2>&1 &
  echo $! >/run/mariiy-ui.pid
  i=$((i + 1))
  sleep 1
done

# Wait briefly for Agent API (port 8080) and start directly if needed
if ! wget -q -O /dev/null http://127.0.0.1:8080/api/health 2>/dev/null \
  && ! busybox wget -q -O /dev/null http://127.0.0.1:8080/api/health 2>/dev/null; then
  /usr/sbin/mariiy-agent-start >/tmp/mariiy-agent.log 2>&1 &
  sleep 1
fi

# Sandbox & rendering environment for Alpine musl + VMware / VAAPI
export MOZ_DISABLE_CONTENT_SANDBOX=1
export MOZ_DISABLE_GMP_SANDBOX=1
export MOZ_DISABLE_RDD_SANDBOX=1
export MOZ_DISABLE_SOCKET_PROCESS_SANDBOX=1
export MOZ_NO_REMOTE=1
export GDK_BACKEND=x11

for f in /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/product_name /sys/class/dmi/id/board_vendor; do
  if [ -r "$f" ] && grep -qi vmware "$f"; then
    export LIBGL_ALWAYS_SOFTWARE=1
    export MOZ_WEBRENDER=0
    break
  fi
done

if command -v firefox >/dev/null 2>&1; then
  mkdir -p /root/.mozilla/firefox/kiosk
  rm -f /root/.mozilla/firefox/kiosk/lock /root/.mozilla/firefox/kiosk/.parentlock 2>/dev/null || true
  while true; do
    firefox --profile /root/.mozilla/firefox/kiosk --kiosk --no-remote "http://127.0.0.1:8765/" >>/var/log/mariiy-firefox.log 2>&1 || true
    sleep 1
  done
fi

if command -v xterm >/dev/null 2>&1; then
  exec xterm -bg black -fg white -e sh -c 'echo "ERROR: firefox missing"; echo "Alt+F2 login root"; sleep 3600'
fi
sleep 30
exit 1
